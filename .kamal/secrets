# Secrets are read from the deployer's environment / password manager at deploy time.
# Do NOT paste secret values into this file. Example using a password manager CLI:
#   SECRETS=$(kamal secrets fetch --adapter 1password --account my-account --from Vault/TKT SECRET_KEY_BASE POSTGRES_PASSWORD)
#   SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE ${SECRETS})
SECRET_KEY_BASE=$SECRET_KEY_BASE
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
DATABASE_URL=postgres://tkt:$POSTGRES_PASSWORD@tkt-db:5432/tkt_production
CACHE_DATABASE_URL=postgres://tkt:$POSTGRES_PASSWORD@tkt-db:5432/tkt_production_cache
QUEUE_DATABASE_URL=postgres://tkt:$POSTGRES_PASSWORD@tkt-db:5432/tkt_production_queue
CABLE_DATABASE_URL=postgres://tkt:$POSTGRES_PASSWORD@tkt-db:5432/tkt_production_cable
