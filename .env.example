# Copy to .env for local use (never commit .env). Placeholders only — no real secrets here.

# --- Local development ---
DATABASE_URL=postgres://tkt:devpass@localhost/tkt_development

# --- Production / staging (set in the host's secret manager, not in files) ---
SECRET_KEY_BASE=                 # generate with: bin/rails secret
APP_HOSTS=thekingdomtrybe.example
DATABASE_URL=
# Separate databases (Hostinger/Kamal). Omit and set SINGLE_DATABASE=true for single-DB hosting (Render free tier).
CACHE_DATABASE_URL=
QUEUE_DATABASE_URL=
CABLE_DATABASE_URL=
SINGLE_DATABASE=false

# Email (any SMTP provider). Without SMTP_ADDRESS no emails are sent.
MAIL_FROM="The Kingdom Trybe <no-reply@thekingdomtrybe.example>"
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Only for previews without email: lets new members use the site for 3 days before confirming.
ALLOW_UNCONFIRMED_ACCESS=false

# Google sign-in (optional). Button is hidden until both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Preview gate: when set, the whole site asks for this password (user "tkt").
PREVIEW_PASSWORD=

# --- Kamal deployment to the Hostinger VPS (deployer's machine only) ---
TKT_WEB_HOST=203.0.113.10
TKT_APP_HOST=thekingdomtrybe.example
POSTGRES_PASSWORD=
