<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [content_for(:title), "The Kingdom Trybe"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || "A faith-based digital church for gamers, streamers and seekers: livestream worship, Trybe community and support." %>">
    <meta name="theme-color" content="#0a0a0a">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <%= render "shared/header", overlay: content_for?(:header_overlay) %>
    <main id="main" tabindex="-1">
      <% unless content_for?(:header_overlay) || controller_name.in?(%w[accounts registrations]) %>
        <div class="container"><%= render "shared/flash" %></div>
      <% end %>
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
