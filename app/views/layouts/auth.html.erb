<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [content_for(:title), "The Kingdom Trybe"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0a0a0a">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="auth-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="auth-page__media" aria-hidden="true"><div class="media-placeholder media-placeholder--fill"></div></div>
    <main id="main" class="auth-card" tabindex="-1">
      <div class="auth-card__frame">
        <%= link_to root_path, class: "brand auth-card__brand" do %>
          <span class="brand__mark" aria-hidden="true">T</span>
          <span class="brand__name">The Kingdom Trybe</span>
        <% end %>
        <%= render "shared/flash" %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
