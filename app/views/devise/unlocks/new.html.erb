<% content_for :title, "Unlock account" %>
<div class="auth-head">
  <h1 class="display display--md">Account locked</h1>
  <p>After 10 wrong passwords an account locks for an hour. You can also get an unlock link by email.</p>
</div>
<%= render "shared/email_notice" %>
<%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "form", novalidate: true }) do |f| %>
  <%= error_summary(resource) %>
  <div class="field">
    <%= f.label :email, "Email", class: "field__label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "field__input" %>
  </div>
  <button type="submit" class="btn btn--block"><span class="btn__label">Send unlock link</span></button>
<% end %>
<p class="auth-foot"><%= link_to "Back to sign in", new_session_path(resource_name) %></p>
