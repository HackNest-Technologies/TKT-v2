<% content_for :title, "Resend confirmation" %>
<div class="auth-head">
  <h1 class="display display--md">Confirm your email</h1>
  <p>We'll resend the confirmation link if the account exists and isn't confirmed yet.</p>
</div>
<%= render "shared/email_notice" %>
<%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "form", novalidate: true }) do |f| %>
  <%= error_summary(resource) %>
  <div class="field">
    <%= f.label :email, "Email", class: "field__label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email), class: "field__input" %>
  </div>
  <button type="submit" class="btn btn--block"><span class="btn__label">Resend link</span></button>
<% end %>
<p class="auth-foot"><%= link_to "Back to sign in", new_session_path(resource_name) %></p>
